<RCC>
    <qresource prefix="/">
        <!-- Interfaz QML -->
        <file alias="qml/main.qml">qml/main.qml</file>

        <!-- Tema (singletons) -->
        <file alias="qml/theme/qmldir">qml/theme/qmldir</file>
        <file alias="qml/theme/Theme.qml">qml/theme/Theme.qml</file>
        <file alias="qml/theme/Style.qml">qml/theme/Style.qml</file>

        <!-- Componentes -->
        <file alias="qml/components/SdmToolButton.qml">qml/components/SdmToolButton.qml</file>
        <file alias="qml/components/TopToolbar.qml">qml/components/TopToolbar.qml</file>
        <file alias="qml/components/Sidebar.qml">qml/components/Sidebar.qml</file>
        <file alias="qml/components/DownloadTable.qml">qml/components/DownloadTable.qml</file>
        <file alias="qml/components/SegmentBar.qml">qml/components/SegmentBar.qml</file>
        <file alias="qml/components/NewTaskModal.qml">qml/components/NewTaskModal.qml</file>
        <file alias="qml/components/SettingsDialog.qml">qml/components/SettingsDialog.qml</file>

        <!-- Recursos graficos (SVG) -->
        <file alias="assets/logo.svg">assets/logo.svg</file>
        <file alias="assets/icon.svg">assets/icon.svg</file>
        <file alias="assets/download.svg">assets/download.svg</file>
        <file alias="assets/folder.svg">assets/folder.svg</file>
    </qresource>
</RCC>
